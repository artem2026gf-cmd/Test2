local function toggle(parent, x, y, on, key)
    local btn = mk("TextButton", {Text = "", Size = UDim2.fromOffset(38, 20), Position = UDim2.fromOffset(x, y)}, parent)
    local track = mk("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = on and ON_T or OFF_T}, btn)
    round(track, 10); outline(track, rgb(58), 0.5)
    local knob = mk("Frame", {Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(on and 21 or 3, 3), BackgroundColor3 = on and rgb(159) or rgb(176)}, track)
    round(knob, 7)
    local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local function apply(v)
        on = v
        TS:Create(track, ti, {BackgroundColor3 = v and ON_T or OFF_T}):Play()
        TS:Create(knob, ti, {Position = UDim2.fromOffset(v and 21 or 3, 3), BackgroundColor3 = v and rgb(159) or rgb(176)}):Play()
        if key then setVal(key, v) end
    end
    btn.Activated:Connect(function() apply(not on) end)
    if key then controls[key] = apply setVal(key, on) end
end

