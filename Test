keep(UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.K then setOpen(not isOpen) end
end))

local snowLayer = mk("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true, Visible = false}, dimGui)
local rng = Random.new()
local flakes = {}
for n = 1, 45 do
    local sz = rng:NextInteger(2, 5)
    local f = mk("Frame", {Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1}, snowLayer)
    round(f, 3)
    flakes[n] = {f = f, x = rng:NextNumber(), y = rng:NextNumber(), speed = rng:NextNumber(40, 110) * (sz / 3.5), sway = rng:NextNumber(6, 22), phase = rng:NextNumber(0, 6.28), base = rng:NextNumber(0.25, 0.65)}
end
local snowAlpha = 0
keep(RS.Heartbeat:Connect(function(dt)
    local target = isOpen and 1 or 0
    snowAlpha = snowAlpha + (target - snowAlpha) * math.min(dt * 3, 1)
    if snowAlpha < 0.01 and not isOpen then snowLayer.Visible = false return end
    snowLayer.Visible = true
    local size = snowLayer.AbsoluteSize
    local t = os.clock()
    for _, s in ipairs(flakes) do
        s.y = s.y + s.speed * dt / math.max(size.Y, 1)
        if s.y > 1.02 then s.y = -0.02 s.x = rng:NextNumber() end
        s.f.Position = UDim2.fromOffset(s.x * size.X + math.sin(t * 0.8 + s.phase) * s.sway, s.y * size.Y)
        s.f.BackgroundTransparency = 1 - (1 - s.base) * snowAlpha
    end
end))

dim.BackgroundTransparency = 1
setOpen(true)

if #errs > 0 then
    warn("[SWILL] Non-fatal errors:\n" .. table.concat(errs, "\n"))
end
print("[SWILL://ONLINE] Nixware GUI loaded")
