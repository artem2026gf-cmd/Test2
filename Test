local function slider(parent, x, y, w, lo, hi, val, numLabel, key)
    local area = mk("TextButton", {Text = "", Size = UDim2.fromOffset(w, 20), Position = UDim2.fromOffset(x, y)}, parent)
    local bg = mk("Frame", {Size = UDim2.new(1, 0, 0, 4), Position = UDim2.new(0, 0, 0.5, -2), BackgroundColor3 = rgb(72)}, area)
    round(bg, 2)
    local fill = mk("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = rgb(159)}, bg)
    round(fill, 2)
    local knob = mk("Frame", {Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = rgb(190)}, bg)
    round(knob, 6)
    local function set(f)
        fill.Size = UDim2.fromScale(f, 1)
        knob.Position = UDim2.fromScale(f, 0.5)
        local v = math.floor(lo + f * (hi - lo) + 0.5)
        numLabel.Text = tostring(v)
        if key then setVal(key, v) end
    end
    set((val - lo) / (hi - lo))
    if key then controls[key] = function(v) v = math.clamp(v or lo, lo, hi) set((v - lo) / (hi - lo)) setVal(key, v) end end
    area.InputBegan:Connect(function(i) if isPointerType(i) then beginDrag2(function(p) local fx = frac(p, bg) set(fx) end, i) end end)
end

local function dropdown(parent, x, y, w, options, current, key, cb)
    local btn = mk("TextButton", {Text = "", Size = UDim2.fromOffset(w, 24), Position = UDim2.fromOffset(x, y)}, parent)
    local bg = mk("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(30)}, btn)
    round(bg, 5); outline(bg, rgb(50), 0.5)
    local txt = label(bg, current, Enum.Font.Gotham, 11, rgb(210), UDim2.fromOffset(8, 0), UDim2.new(1, -20, 1, 0))
    txt.ZIndex = 5
    label(bg, "v", Enum.Font.GothamBold, 10, rgb(150), UDim2.new(1, -16, 0, 0), UDim2.fromOffset(14, 24)).TextXAlignment = Enum.TextXAlignment.Center
    local list, open = nil, false
    local function close() open = false if list then list:Destroy() list = nil end end
    btn.Activated:Connect(function()
        open = not open
        if open then
            list = mk("Frame", {Size = UDim2.fromOffset(w, #options * 24), Position = UDim2.new(0, 0, 1, 4), BackgroundColor3 = rgb(20), ZIndex = 20}, btn)
            round(list, 5); outline(list, rgb(55), 0.4)
            for i, opt in ipairs(options) do
                local o = mk("TextButton", {Text = opt, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = rgb(210), Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, (i - 1) * 24), BackgroundTransparency = 1, ZIndex = 21}, list)
                o.MouseEnter:Connect(function() o.TextColor3 = rgb(255) end)
                o.MouseLeave:Connect(function() o.TextColor3 = rgb(210) end)
                o.Activated:Connect(function()
                    txt.Text = opt
                    if key then setVal(key, opt) end
                    if cb then cb(opt) end
                    close()
                end)
            end
        else close() end
    end)
    if key then setVal(key, current) controls[key] = function(v) if type(v) == "string" then txt.Text = v setVal(key, v) if cb then cb(v) end end end end
end

