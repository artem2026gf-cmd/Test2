local vpf, cam
local model, center, base
local yaw, vel, rotating, lastX = 0, 0, false, 0

local junk = {
    Script = true, LocalScript = true, ModuleScript = true, Sound = true, ParticleEmitter = true,
    Beam = true, Trail = true, Fire = true, Smoke = true, Sparkles = true, PointLight = true,
    SpotLight = true, SurfaceLight = true, ForceField = true, Shirt = true, Pants = true,
    ShirtGraphic = true, Decal = true, Texture = true, SurfaceAppearance = true, Highlight = true,
    BillboardGui = true, SurfaceGui = true, Tool = true,
}
local faceNames = {Face = true, Eyebrow = true, Eyelash = true}

local function applyYaw()
    if model then
        model:PivotTo(CFrame.new(center) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.new(-center) * base)
    end
end

local function buildModel()
    if model then model:Destroy() model = nil end
    local char = LP.Character
    if not char then return end
    local ok, err = pcall(function()
        char.Archivable = true
        local m = char:Clone()
        char.Archivable = false
        for _, d in ipairs(m:GetDescendants()) do
            if junk[d.ClassName] or d:IsA("FaceControls") then d:Destroy()
            elseif d:IsA("Accessory") and d.AccessoryType and faceNames[d.AccessoryType.Name] then d:Destroy() end
        end
        for _, d in ipairs(m:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Color = rgb(155)
                d.Material = Enum.Material.SmoothPlastic
                d.Reflectance = 0
                d.Anchored = true
                if d:IsA("MeshPart") then d.TextureID = "" end
            elseif d:IsA("SpecialMesh") then
                d.TextureId = ""
            end
        end
        local hum = m:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
        m.Parent = vpf
        m:PivotTo(CFrame.new(0, 0, 0))
        local cf, size = m:GetBoundingBox()
        center, base = cf.Position, m:GetPivot()
        local wide = math.max(size.X, size.Z)
        local need = math.max(size.Y, wide / 0.67)
        local dist = need * 0.5 / math.tan(math.rad(15)) * 1.22
        cam.CFrame = CFrame.lookAt(center + Vector3.new(0, size.Y * 0.03, dist), center)
        model = m
        yaw, vel = 0, 0
        applyYaw()
    end)
    if not ok then warn("Nix model: " .. tostring(err)) end
end

