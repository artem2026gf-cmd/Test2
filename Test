local function frac(pos, obj)
    local rel = (Vector2.new(pos.X, pos.Y) - obj.AbsolutePosition) / obj.AbsoluteSize
    return math.clamp(rel.X, 0, 1), math.clamp(rel.Y, 0, 1)
end
