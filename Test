local mk, soft, rgb, cs, ns, round, outline, grad, label, isPointerType
do
    local function setProp(o, k, v) o[k] = v end
    mk = function(class, props, parent)
        local o = Instance.new(class)
        if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
        if class == "TextButton" then o.BackgroundTransparency = 1 end
        for k, v in pairs(props) do
            local ok, e = pcall(setProp, o, k, v)
            if not ok then table.insert(errs, class .. "." .. tostring(k) .. ": " .. tostring(e)) end
        end
        o.Parent = parent
        return o
    end
    soft = function(name, f, ...) local ok, e = pcall(f, ...) if not ok then table.insert(errs, name .. ": " .. tostring(e)) end end
    rgb = function(v) return Color3.fromRGB(v, v, v) end
    cs = function(a, b) return ColorSequence.new(rgb(a), rgb(b)) end
    ns = function(a, b) return NumberSequence.new(a, b) end
    round = function(o, r) return mk("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
    outline = function(o, c, t) return mk("UIStroke", {Color = c, Transparency = t, Thickness = 1}, o) end
